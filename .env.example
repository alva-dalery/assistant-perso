# Copiez ce fichier en `.env.local` pour tester localement si besoin
# (ces variables ne sont utilisées QUE pour la protection en ligne).

# Identifiant de connexion (Basic Auth)
SITE_USER=moi

# Mot de passe : 20+ caractères aléatoires, ASCII uniquement.
# Générateur rapide : openssl rand -base64 24
SITE_PASSWORD=remplace-moi-par-un-mot-de-passe-long-et-aleatoire

# --- Connexion Gmail (IMAP + SMTP) ---
# Nécessite la validation en deux étapes activée sur le compte Google.
# Le mot de passe d'application se génère sur myaccount.google.com → Sécurité
# → Mots de passe des applications (16 caractères, les espaces sont ignorés).
GMAIL_USER=votre.adresse@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
