# Copiez ce fichier en `.env.local` pour tester localement si besoin
# (ces variables ne sont utilisées QUE pour la protection en ligne).

# Identifiant de connexion (Basic Auth)
SITE_USER=moi

# Mot de passe : 20+ caractères aléatoires, ASCII uniquement.
# Générateur rapide : openssl rand -base64 24
SITE_PASSWORD=remplace-moi-par-un-mot-de-passe-long-et-aleatoire

# --- Connexion Gmail (IMAP + SMTP) ---
# Nécessite la validation en deux étapes activée sur le compte Google.
# Le mot de passe d'application se génère sur myaccount.google.com → Sécurité
# → Mots de passe des applications (16 caractères, les espaces sont ignorés).
GMAIL_USER=votre.adresse@gmail.com
GMAIL_APP_PASSWORD=abcd efgh ijkl mnop

# --- Intelligence Artificielle (DeepSeek API) ---
# Obtenez votre clé API sur https://platform.deepseek.com/api_keys
# Laissez DEEPSEEK_MODEL à "deepseek-chat" (rapide) ou "deepseek-reasoner" (raisonnement).
DEEPSEEK_API_KEY=sk-remplace-moi-par-ta-cle-deepseek
DEEPSEEK_MODEL=deepseek-chat

# --- Suivi Colissimo / La Poste (API Suivi v2, 100% gratuit) ---
# Créez une clé gratuite (sans carte bancaire) sur https://developer.laposte.fr/
# LAPOSTE_API_KEY=votre-cle-okapi-laposte

# --- Google Drive (rangement automatique des factures) ---
# URL de déploiement de votre Google Apps Script (Web App) + jeton secret partagé.
# GOOGLE_DRIVE_WEBHOOK_URL=https://script.google.com/macros/s/.../exec
# GOOGLE_DRIVE_WEBHOOK_SECRET=un-secret-aleatoire
